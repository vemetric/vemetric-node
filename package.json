{
  "name": "@vemetric/node",
  "repository": {
    "type": "git",
    "url": "https://github.com/vemetric/vemetric-node.git"
  },
  "homepage": "https://vemetric.com/docs/sdks/nodejs",
  "version": "0.2.0",
  "description": "Official Node.js, Bun, Deno SDK for Vemetric",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepublish": "pnpm run build",
    "build": "tsup && node after-build.mjs",
    "dev": "npm run build -- --watch",
    "lint": "eslint --max-warnings=0 --ext .js,.jsx,.ts,.tsx . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "typescript",
    "sdk",
    "node-js",
    "bun",
    "deno",
    "vemetric"
  ],
  "author": "Vemetric <info@vemetric.com> (https://vemetric.com/)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^3.2.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7"
    }
  }
}
